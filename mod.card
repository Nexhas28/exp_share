-- Sharing metadata for the manager detail pane.
return {
  summary = "Party-wide EXP from the OPTIONS menu: Gen 1 Exp. All style, Gen 5+ Exp. Share style, BALANCED / AVERAGE presets, or CUSTOM 10%-100% sharing with per-slot overrides — one shared-exp line instead of a message per Pokemon. Works on Red/Blue/Yellow, Gold, and FireRed/LeafGreen/Ruby/Sapphire/Emerald.",
  author = "shanemcgovern",
  tags = { "gameplay", "exp", "qol" },
  differences = {
    changed = {
      "EXP SHARE sits in the OPTIONS menu: OFF / GEN 1 / GEN 5+ / BALANCED / AVERAGE / CUSTOM (cycles with LEFT/RIGHT)",
      "GEN 1: the fighters split half the exp; the whole party splits the other half, exactly like holding the EXP. All item (division bug included)",
      "GEN 5+: the fighters keep the full exp split between them; every alive bench mon gets half a fighter's share",
      "BALANCED: the GEN 5+ split, but a bench mon only gains exp while below the active fighter's level",
      "AVERAGE: the same gate measured against the party's average level (whole party, floored) instead of the active fighter",
      "CUSTOM: fighters keep the full share; the bench receives a global or per-slot 10%-100% percentage of that share",
      "Shared exp prints ONE \"EXP is shared amongst the party\" line instead of an individual gain message per Pokemon",
    },
    added = {
      "LEVEL UP JINGLE option in OPTIONS: toggle between LEVEL UP (default fanfare) and ITEM (regular item pickup chime) for faster level-up transitions. On Gen 3, ITEM also covers the coin-case and hidden-item pickup jingles",
      "Level-ups, stat boxes and move learning still show for every mon that gained exp",
    },
    known = {
      "OFF keeps the vanilla behavior, including the vanilla EXP. All item's per-mon messages",
      "Bench mons get half the stat experience too (the engine splits stat exp with the same divisor)",
    },
  },
  credits = {
    { who = "Pokemon Gen 1 Recompilation Project", for_ = "the engine and its mod seams" },
  },
  compat = { engine = ">=0.0.0 <2.0.0", modApi = 2 },
}
